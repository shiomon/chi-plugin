  "calc": [
    "一份正好够 2-3 个人吃。",
    "鸡爪 1kg",
    "姜 4 片",
    "料酒 65g",
    "大葱 3 段（5cm 一段）",
    "大蒜 10 瓣",
    "小米辣 4 个少辣，6 个中辣，12 个大辣（推荐大辣）",
    "洋葱 （半个）",
    "生抽 75g = 15g  5",
    "蚝油 30g = 15g  2",
    "黑醋（推荐陈醋） 50g",
    "白糖 10g",
    "盐 3g",
    "花椒油 10ml",
    "香菜 3 颗",
    "柠檬 2 颗（以 1 颗为单位来调整酸度）"
  ]
