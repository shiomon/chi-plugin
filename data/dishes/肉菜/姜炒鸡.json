  "calc": [
    "鸡 = 半只（土鸡最好，预计 650g）",
    "食用油 = 50ml（茶油最好，没有就用菜籽油）",
    "生姜 = 半斤 (250g)",
    "啤酒 = 半瓶 250ml",
    "生抽 = 20ml",
    "老抽 = 10ml",
    "盐 = 3g",
    "小米椒 = 0-5 个 (0-50g)（根据辣口味调整）",
    "美人辣 = 0-5 个 (0-50g)（没有可以用小米椒代替）",
    "泡椒 = 5 个 (50g)",
    "大蒜 = 3 头 (50g)"
  ]
