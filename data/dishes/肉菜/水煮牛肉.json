  "time": null,
  "desc": "水煮牛肉是川菜中的经典麻辣味型，口感滑嫩、汤汁红亮、香辣烫鲜。牛肉富含优质蛋白质和铁，搭配豆芽可补充膳食纤维。这道菜对新手来说不算太难，但需注意火候和泼油安全，整体制作约需四十分钟。",
  "ingredients": [
    "牛肉",
    "豆芽",
    "鸡蛋",
    "香菜",
    "豆瓣酱",
    "料酒",
    "淀粉",
    "干辣椒粉",
    "姜",
    "蒜",
    "红辣椒",
    "蚝油"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "牛肉洗干净切片。"
        },
        {
          "sub": false,
          "text": "加入 15g 姜丝，1 个鸡蛋，15g 淀粉，8g 蚝油，10ml 料酒搅拌均匀，腌制 15 分钟。"
        },
        {
          "sub": false,
          "text": "香菜洗干净切好。"
        },
        {
          "sub": false,
          "text": "锅里倒油，加入豆瓣酱，5g 姜丝，蒜片。"
        },
        {
          "sub": false,
          "text": "倒入开水，煮成红汤。"
        },
        {
          "sub": false,
          "text": "豆芽洗干净去掉尾须，放进开水里焯熟。"
        },
        {
          "sub": false,
          "text": "将豆芽铺入碗底。"
        },
        {
          "sub": false,
          "text": "将牛肉片一片一片的放进红汤中，煮熟以后捞出。"
        },
        {
          "sub": false,
          "text": "将牛肉铺在豆芽上，撒上香菜梗。"
        },
        {
          "sub": false,
          "text": "撒上香菜叶，辣椒粉，辣椒圈。"
        },
        {
          "sub": false,
          "text": "另起锅烧热油，将热油淋在菜上面，就完成了。"
        }
      ]
    }
  ],
