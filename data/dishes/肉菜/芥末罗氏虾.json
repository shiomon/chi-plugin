    "罗氏虾 250g",
    "蒜 1-2 个",
    "青芥末 20g，用于碗汁",
    "生粉 10g，用于碗汁",
    "生抽 30g，用于碗汁",
    "胡椒粉 5g，用于碗汁",
    "白糖 3g，用于碗汁",
    "蚝油 15g，用于碗汁",
    "盐 3g，用于碗汁",
    "小米辣 1-2 个",
    "黄油 20g",
    "食用油 80ml"
  ]
}
