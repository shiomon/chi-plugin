  "name": "黄焖鸡",
  "category": "meat_dish",
  "categoryName": "肉菜",
  "difficulty": 3,
  "calories": 766,
  "time": "40分钟",
  "desc": "黄焖鸡是一道以鸡腿、香菇、青椒为主料的家常菜，汤汁浓郁，鸡肉滑嫩，咸鲜微甜，十分下饭。富含优质蛋白质和菌菇多糖等营养。炒糖色环节稍有挑战，但可用老抽替代，整体难度不高，新手也能顺利掌握。从备菜到出锅，大约需要 40 分钟。",
  "ingredients": [
    "鸡腿",
    "香菇（干香菇最佳）",
    "青椒",
    "生姜片",
    "干辣椒",
    "盐",
    "料酒",
    "白胡椒粉",
    "白糖",
    "酱油",
    "味精",
    "土豆（可选）"
  ],
  "steps": [
    {
      "title": "备菜阶段",
      "items": [
        {
          "sub": false,
          "text": "鸡腿洗净，剁成4cm大小的块"
        },
        {
          "sub": false,
          "text": "生姜切片、干辣椒切成小圈"
        },
        {
          "sub": false,
          "text": "香菇切片，青椒切成细长的马蹄状，若为干香菇，洗净灰尘后泡一晚上并留香菇水备用"
        },
        {
          "sub": false,
          "text": "若有土豆，切为与鸡肉大小类似的滚刀块"
        }
      ]
    },
    {
      "title": "炒制阶段",
      "items": [
        {
          "sub": false,
          "text": "炒糖色：锅里倒入底油，冷油时放入白糖（有一定难度，新手可跳至鸡肉炒制并使用老抽替代）"
        },
        {
          "sub": false,
          "text": "小火慢慢加热，待油温逐渐升高，白糖开始融化并变成较深的棕色（期间要不断搅拌，防止糊锅）"
        },
        {
          "sub": false,
          "text": "迅速倒入鸡块，转大火，快速翻炒！烹入料酒，继续翻炒片刻"
        },
        {
          "sub": false,
          "text": "将生姜片和干辣椒倒入"
        },
        {
          "sub": false,
          "text": "放入酱油，炒匀"
        },
        {
          "sub": false,
          "text": "倒入香菇水或清水，以能淹住鸡肉为准"
        },
        {
          "sub": false,
          "text": "倒入香菇片，白胡椒粉，盐，土豆"
        },
        {
          "sub": false,
          "text": "翻炒均匀后，盖上锅盖焖煮，转中小火15——20分钟，有条件可以转至砂锅"
        },
        {
          "sub": false,
          "text": "待鸡肉软烂，汤汁浓稠后（汤汁不要收的太干），最后放入青椒"
        },
        {
          "sub": false,
          "text": "放入味精，兜炒均匀后，关火！青椒基本断生即可，不要炒时间久了"
        }
      ]
    }
  ],
