  "desc": "腌制入味的鸡中翅经高温烘烤，外皮微焦、内里鲜嫩多汁，带有黑胡椒和酱油的咸香。富含优质蛋白质和胶原蛋白。难度适中，新手也能轻松上手，从准备到出炉大约需要 1 小时。还可按喜好添加蜂蜜或五香粉增添风味。",
  "ingredients": [
    "鸡翅中",
    "盐",
    "黑胡椒粉",
    "酱油",
    "料酒",
    "烤箱"
  ],
  "steps": [
    {
      "title": "鸡翅的预处理",
      "items": [
        {
          "sub": false,
          "text": "鸡翅放入碗中"
        },
        {
          "sub": false,
          "text": "加盐、黑胡椒粉、酱油、料酒进行腌制 30-40 分钟"
        }
      ]
    },
    {
      "title": "烤制过程",
      "items": [
        {
          "sub": false,
          "text": "将烤箱预热至 200℃"
        },
        {
          "sub": false,
          "text": "将腌制好的鸡翅均匀地放在烤盘上"
        },
        {
          "sub": false,
          "text": "将烤盘放入烤箱中层，烤 15-20 分钟"
        },
        {
          "sub": false,
          "text": "取出烤盘，将鸡翅翻面，再烤 15-20 分钟，直到熟透"
        }
      ]
    }
  ],
  "tips": [
    "可以在腌制鸡翅时加入蜂蜜、酱油、姜蒜粉、五香粉等作为调味料，提升口感和香气",
    "烤鸡翅时，建议将烤盘底部垫上一层锡纸，便于清洁烤盘"
  ],
