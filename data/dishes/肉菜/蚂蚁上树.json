  "category": "meat_dish",
  "categoryName": "肉菜",
  "difficulty": 3,
  "calories": 791,
  "time": "20分钟",
  "desc": "蚂蚁上树是一道经典的川味家常菜，咸香微辣，粉丝软滑吸汁，肉末细嫩鲜香。以红薯粉丝和肉末为主料，富含碳水化合物与蛋白质，能快速补充能量。制作难度中等，步骤清晰，对新手比较友好，全程约需 20 分钟即可完成。",
  "ingredients": [
    "红薯粉丝",
    "猪肉末（或牛肉末）",
    "郫县豆瓣酱",
    "生抽",
    "老抽",
    "食用油",
    "蒜末、姜末",
    "小葱（可选）"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "红薯粉丝提前泡软，泡水时间为 20 分钟，备用"
        },
        {
          "sub": false,
          "text": "将蒜、姜分别剁碎，备用"
        },
        {
          "sub": false,
          "text": "锅烧热，加入 10ml 食用油，加入蒜末、姜末炒香"
        },
        {
          "sub": false,
          "text": "加入猪肉末翻炒至肉色发白且微微出油"
        },
        {
          "sub": false,
          "text": "加入郫县豆瓣酱，炒至红油析出"
        },
        {
          "sub": false,
          "text": "加入生抽和老抽，翻炒均匀"
        },
        {
          "sub": false,
          "text": "倒入 300ml 清水，煮沸"
        },
        {
          "sub": false,
          "text": "放入泡软沥干的粉丝，用筷子轻轻拨动防止粘连"
        },
        {
          "sub": false,
          "text": "中小火煮约 5 分钟，直至粉丝完全吸收汤汁、呈现微微收干状态"
        },
        {
          "sub": false,
          "text": "依据口味可撒入小葱末，关火装盘"
        }
      ]
    }
  ],
  "tips": [
    "粉丝不建议煮太久，易断且口感变差；若时间过长汤汁应适当减少",
    "郫县豆瓣酱含盐量较高，可根据口味酌情减少生抽用量",
    "可加入 0.5g 白胡椒粉调味，风味更佳"
  ],
