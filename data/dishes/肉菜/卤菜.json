    "黄豆酱 15ml",
    "豆瓣酱 15ml",
    "蚝油 15ml",
    "南腐乳 15ml",
    "洋葱 半个（约 100g）",
    "生姜 30g",
    "大蒜 40g",
    "干辣椒 10g",
    "生抽 120ml",
    "老抽 60ml",
    "盐 10-15g",
    "白糖 30g（用于熬糖色）",
    "啤酒 1 罐(330ml)",
    "牛腱子 500g",
    "清水 足量（需要没过所有肉类）"
  ]
}
