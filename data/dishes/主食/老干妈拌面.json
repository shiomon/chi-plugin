  "desc": "一道香辣开胃的家常快手面食，面条筋道裹满老干妈的豆豉辣香，酱油提鲜，简单却滋味十足。作为主食能快速补充碳水化合物和能量，辣椒素还有助促进食欲。制作毫无门槛，新手也能轻松驾驭，从烧水到出锅只需大约十 分钟。",
  "ingredients": [
    "面",
    "老干妈",
    "酱油"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "将水倒入锅中并煮沸"
        },
        {
          "sub": false,
          "text": "将面均匀放入锅中"
        },
        {
          "sub": false,
          "text": "在煮的过程注意搅拌，避免面粘成一坨"
        },
        {
          "sub": false,
          "text": "当用筷子挑起一根面且该面能自然地从筷子上滑落时再等 30 秒关火"
        },
        {
          "sub": false,
          "text": "将面夹入碗中"
        },
        {
          "sub": false,
          "text": "按照上面的计量放入老干妈和酱油"
        },
        {
          "sub": false,
          "text": "用筷子将碗里的面、老干妈、酱油拌均匀"
        },
        {
          "sub": false,
          "text": "吃"
        }
      ]
    }
  ],
