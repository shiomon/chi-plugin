  "desc": "一道简单快手的日式风味饭团，咸香火腿搭配沙拉酱与海苔，口感丰富饱腹。富含碳水化合物、蛋白质和维生素，能快速补充能量。制作难度极低，新手也能轻松上手，从煮饭到完成大约只需 1 小时。",
  "ingredients": [
    "火腿",
    "米饭",
    "水",
    "冷冻青豆（可选）",
    "冷冻玉米粒（可选）",
    "海苔碎（可选）",
    "喜欢的沙拉酱（推荐日式 mayo！）"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "将米饭和水放到电饭锅里，点击米饭模式，等待完成"
        },
        {
          "sub": false,
          "text": "冷冻玉米粒和青豆放到锅里，加水没过所有食材，沸腾后静待 2 分钟后，捞出。"
        },
        {
          "sub": false,
          "text": "火腿切成 1cm 的方块"
        },
        {
          "sub": false,
          "text": "与此同时，加入 10ml 食用油，加入火腿翻炒至火腿上色"
        },
        {
          "sub": false,
          "text": "将米饭，火腿，海苔碎，青豆，玉米粒，沙拉酱放入碗中，混合均匀即可"
        },
        {
          "sub": false,
          "text": "装盘（如果有的话）"
        }
      ]
    }
  ],
  "tips": [
    "沙拉酱的程度可以根据个人口味酌情删减。",
