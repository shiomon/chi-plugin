    "瘦肉末 250g",
    "肥肉末 20g #不喜可不加",
    "姜 3g",
    "葱 15g",
    "盐 3g",
    "蚝油 2ml",
    "香油 2ml",
    "生抽 2ml",
    "鸡蛋 1 个"
  ],
