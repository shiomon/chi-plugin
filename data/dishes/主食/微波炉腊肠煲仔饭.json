{
  "id": "主食/微波炉腊肠煲仔饭",
  "md": "dishes/staple/微波炉腊肠煲仔饭/微波炉腊肠煲仔饭.md",
  "name": "微波炉腊肠煲仔饭",
  "category": "staple",
  "categoryName": "主食",
  "difficulty": 2,
  "calories": 1039,
  "time": "15分钟",
  "desc": "这是一道简单快手的粤式风味主食，米饭吸足腊肠油脂后油润咸香，搭配脆嫩青菜和胡萝卜，口感层次丰富。富含碳水化合物、蛋白质和多种维生素，营养均衡。烹饪用微波炉操作，对新手十分友好，预计全程仅需 15 分钟即可享用。",
  "ingredients": [
    "工具",
    "微波炉",
    "2 个大碗（推荐微波炉专用碗）",
    "1 个小碗",
    "原料",
    "米 200 ml",
    "腊肠 1 根",
    "鸡蛋 1 个",
    "红萝卜 1 个",
    "盐",
    "油 15 ml",
    "生抽 10 ml",
    "香葱 1 颗"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "将米淘洗干净后倒入 饭碗 内，加入 400ml 的水，盖上盖"
        },
        {
          "sub": false,
          "text": "放入微波炉，高火，6 分钟，煮饭途中准备原料"
        },
        {
          "sub": true,
          "text": "切好腊肠"
        },
        {
          "sub": true,
          "text": "洗好青菜"
        },
        {
          "sub": true,
          "text": "切好红萝卜片"
        },
        {
          "sub": true,
          "text": "切好葱花"
        },
        {
          "sub": true,
          "text": "青菜碗 中放入青菜、红萝卜片，倒入 10 ml 油，放入 5 g 盐"
        },
        {
          "sub": true,
          "text": "小碗 中倒入 10 ml 生抽、5 ml 油"
        },
        {
          "sub": false,
          "text": "6 分钟后，用毛巾或隔热手套取出碗，可以看见米饭已经八分熟"
        },
        {
          "sub": false,
          "text": "在米饭上摆入切片的腊肠，继续高火 2 分钟"
        },
        {
          "sub": false,
          "text": "取出腊肠饭，放入 青菜碗，高火 4-5 分钟"
        },
        {
          "sub": false,
          "text": "在腊肠饭上摆好青菜，磕入鸡蛋，看个人喜好继续高火 40-60 秒"
        },
        {
          "sub": false,
          "text": "取出腊肠饭，此时已经基本完成。"
        },
        {
          "sub": false,
          "text": "将 小碗 放入，继续高火 30 秒"
        },
        {
          "sub": false,
          "text": "在腊肠饭上淋上叮热的生抽，撒上葱花即可"
        },
        {
          "sub": false,
          "text": "多余的青菜可以沾着酱油吃"
        }
      ]
    }
  ],
