    "大蒜   3 瓣",
    "小米辣  3 颗",
    "辣椒粉  10g",
    "酱油   10ml",
    "醋   10ml",
    "白糖  3ml",
    "鸡精  3g",
    "盐  3g",
    "花生碎  5g",
    "香菜  5g"
  ]
