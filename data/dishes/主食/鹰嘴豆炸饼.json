{
  "id": "主食/鹰嘴豆炸饼",
  "md": "dishes/staple/鹰嘴豆炸饼.md",
  "name": "鹰嘴豆炸饼",
  "category": "staple",
  "categoryName": "主食",
  "difficulty": 4,
  "calories": 1098,
  "time": "50分钟",
  "desc": "鹰嘴豆咖喱配油炸面饼是北印度经典街头小吃，松软的炸饼搭配香料浓郁的鹰嘴豆，口感层次丰富，酸辣咸香。鹰嘴豆富含植物蛋白和膳食纤维，饱腹又营养。制作步骤稍多，但跟着流程走并不难，适合有一定基础的家常烹饪。约 50 分钟即可完成（鹰嘴豆需提前浸泡 8 小时）。",
  "ingredients": [
    "鹰嘴豆（干）",
    "中筋面粉",
    "酸奶",
    "洋葱",
    "番茄",
    "生姜",
    "大蒜",
    "青辣椒",
    "香菜",
    "红茶包（用于鹰嘴豆上色）",
    "食用油",
    "姜黄粉",
    "红辣椒粉",
    "香菜粉",
    "孜然粉",
    "印度综合香料粉(Garam Masala)",
    "石榴粉(Amchur/Anardana)— 可用柠檬汁替代",
    "盐",
    "小苏打",
    "深锅（炸饼用）"
  ],
  "steps": [
    {
      "title": "准备工作（提前 8 小时）",
      "items": [
        {
          "sub": false,
          "text": "将干鹰嘴豆用清水浸泡过夜（至少 8 小时），浸泡后体积会膨胀至约两倍"
        }
      ]
    },
    {
      "title": "煮鹰嘴豆",
      "items": [
        {
          "sub": false,
          "text": "将浸泡好的鹰嘴豆沥干水分"
        },
        {
          "sub": false,
          "text": "放入锅中，加入 500ml 水和 1 个红茶包（用于上色）"
        },
        {
          "sub": false,
          "text": "大火煮沸后转中火，煮 25-30 分钟，直至鹰嘴豆用手指可以轻松压碎"
        },
        {
          "sub": false,
          "text": "取出红茶包，保留煮豆的汤水，备用"
        }
      ]
    },
    {
      "title": "炒制咖喱酱",
      "items": [
        {
          "sub": false,
          "text": "在炒锅中倒入 30ml 食用油，中火加热"
        },
        {
          "sub": false,
          "text": "放入切碎的洋葱，翻炒至金棕色（约 6-8 分钟）"
        },
        {
          "sub": false,
          "text": "加入磨碎的生姜和大蒜，翻炒 1 分钟"
        },
        {
          "sub": false,
          "text": "加入切碎的番茄，翻炒至番茄完全软烂出油（约 5 分钟）"
        },
        {
          "sub": false,
          "text": "加入姜黄粉 3g、红辣椒粉 5g、香菜粉 8g、孜然粉 5g、盐 6g"
        },
        {
          "sub": false,
          "text": "翻炒 2 分钟，使香料充分释放香味"
        },
        {
          "sub": false,
          "text": "将煮好的鹰嘴豆连同汤水一起倒入锅中"
        },
        {
          "sub": false,
          "text": "加入青辣椒，搅拌均匀"
        },
        {
          "sub": false,
          "text": "大火煮沸后转小火，炖 15-20 分钟，期间可用铲子背面压碎一些鹰嘴豆使汤汁变稠"
        },
        {
          "sub": false,
          "text": "加入印度综合香料粉 5g 和石榴粉 3g（或柠檬汁 15ml）"
        },
        {
          "sub": false,
          "text": "搅拌均匀后关火，备用"
        }
      ]
    },
    {
      "title": "制作炸饼面团",
      "items": [
        {
          "sub": false,
          "text": "在大碗中混合中筋面粉 250g、小苏打 2g、盐 3g"
        },
        {
          "sub": false,
          "text": "加入酸奶 60ml 和食用油 15ml"
        },
        {
          "sub": false,
          "text": "逐渐加入温水，边加边揉，揉成光滑柔软的面团（面团应比普通面团稍软）"
        },
        {
          "sub": false,
          "text": "用湿布盖住面团，静置 30 分钟"
        }
      ]
    },
    {
      "title": "炸制面饼",
      "items": [
        {
          "sub": false,
          "text": "将面团分成 8 个等大的小剂子"
        },
        {
          "sub": false,
          "text": "取一个剂子，手上沾少量油，擀成直径约 15cm、厚度约 3mm 的圆形面饼"
        },
        {
          "sub": false,
          "text": "在深锅中倒入 500ml 食用油，中大火加热至油温约 180°C"
        },
        {
          "sub": false,
          "text": "将面饼轻轻滑入热油中，用漏勺轻轻按压面饼使其膨胀鼓起"
        },
        {
          "sub": false,
          "text": "炸 1-2 分钟，翻面炸至两面金黄"
        },
        {
          "sub": false,
          "text": "捞出，用厨房纸吸去多余油分"
        }
      ]
    },
    {
      "title": "上菜",
      "items": [
        {
          "sub": false,
          "text": "将鹰嘴豆咖喱重新加热"
        },
        {
          "sub": false,
          "text": "炸饼趁热上桌，搭配鹰嘴豆咖喱食用"
        },
        {
          "sub": false,
          "text": "可搭配切片洋葱、青辣椒和柠檬角"
        }
      ]
    }
  ],
  "tips": [
    "鹰嘴豆提前浸泡是必须步骤，不泡的话煮不软。如果时间紧迫，可以用高压锅将未泡的鹰嘴豆压 20 分钟。",
    "红茶包的作用是给鹰嘴豆上色，使其呈现深棕色。这是印度餐厅的秘诀。",
    "炸饼面团中的酸奶和小苏打是其松软蓬松的关键。面团不宜太硬。",
    "这道菜在印度是国民级的早午餐，从路边摊到高档餐厅都有供应。在中国的印度餐厅中通常被称为\"鹰嘴豆咖喱配炸饼\"。"
  ],
