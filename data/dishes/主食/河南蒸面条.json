{
  "id": "主食/河南蒸面条",
  "md": "dishes/staple/河南蒸面条/河南蒸面条.md",
  "name": "河南蒸面条",
  "category": "staple",
  "categoryName": "主食",
  "difficulty": 4,
  "calories": 3066,
  "time": "40分钟",
  "desc": "河南蒸面条是源自河南的家常小吃，面条先蒸后炒再蒸，油润入味，口感劲道爽滑。五花肉和蒜薹提供丰富的蛋白质和膳食纤维，搭配主食带来均衡营养。制作步骤稍多一些，但对新手而言只要按顺序操作就能成功。从备料到出锅，总共约需 40 分钟。",
  "ingredients": [
    "挂面 （推荐圆的）",
    "五花肉",
    "蒜薹",
    "葱 + 姜 + 蒜 + 料酒",
    "盐 + 鸡精 + 十三香",
    "生抽 + 老抽 + 蚝油",
    "麻油",
    "油 + 锅 + 菜刀 + 铲子",
    "蒸篦子",
    "额外的盆"
  ],
  "steps": [
    {
      "title": "第一次蒸",
      "items": [
        {
          "sub": false,
          "text": "起锅加 7 成水，水开，上蒸篦子"
        },
        {
          "sub": false,
          "text": "将挂面，均匀铺开放置，淋 5ml 油并抹匀，蒸 15 分钟"
        },
        {
          "sub": false,
          "text": "将挂面和蒸篦子取出，放置一边，并倒掉锅中的水"
        }
      ]
    },
    {
      "title": "切菜",
      "items": [
        {
          "sub": false,
          "text": "五花肉，切成 2mm 厚度的肉片"
        },
        {
          "sub": false,
          "text": "蒜薹，切成 3cm 段"
        },
        {
          "sub": false,
          "text": "葱，切成 0.2cm 薄片"
        },
        {
          "sub": false,
          "text": "姜，切成 1mm x 1mm x 3cm 的细丝"
        },
        {
          "sub": false,
          "text": "蒜，放在砧板上拍碎，切成 1mm 的粒度"
        }
      ]
    },
    {
      "title": "炒制",
      "items": [
        {
          "sub": false,
          "text": "起锅，烧干水分，加 3ml 食用油"
        },
        {
          "sub": false,
          "text": "手持锅柄，摇晃锅，使食用油充分挂满锅的 2/3"
        },
        {
          "sub": false,
          "text": "中火，加入肉片，翻炒 1 分钟"
        },
        {
          "sub": false,
          "text": "加入葱姜蒜，料酒，继续翻炒 1 分钟"
        },
        {
          "sub": false,
          "text": "将蒜薹段，放入锅中，翻炒 1 分钟"
        },
        {
          "sub": false,
          "text": "开始调味，加入老抽、生抽、蚝油、盐、鸡精、十三香，翻炒 1 分钟"
        },
        {
          "sub": false,
          "text": "加入 500ML 水，没过蔬菜，炖煮 1 分钟"
        },
        {
          "sub": false,
          "text": "将蒸好的挂面放入，不断搅拌 3 分钟，待挂面全部均匀上色，关火"
        },
        {
          "sub": false,
          "text": "将搅拌好的挂面和菜，全部倒入额外的盆中"
        }
      ]
    },
    {
      "title": "第二次蒸",
      "items": [
        {
          "sub": false,
          "text": "起锅，加冷水 7 成，放上蒸篦子，将拌好的面条和菜，均匀的铺在上面"
        },
        {
          "sub": false,
          "text": "水开后，大火烧 15 分钟，出锅"
        },
        {
          "sub": false,
          "text": "淋上 10g 的麻油，即可食用"
        }
      ]
    }
  ],
  "tips": [
    "挂面的粗细与口感：",
    "细的、圆的 （超市大部分都是这种，口感更加劲道）",
    "宽的、扁的 （口感比较软）"
  ],
