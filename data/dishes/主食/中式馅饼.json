{
  "id": "主食/中式馅饼",
  "md": "dishes/staple/中式馅饼/中式馅饼.md",
  "name": "中式馅饼",
  "category": "staple",
  "categoryName": "主食",
  "difficulty": 4,
  "calories": 1265,
  "time": "1小时",
  "desc": "这道饼外皮微脆内里松软，馅料咸香，属于家常面食。富含碳水化合物和蛋白质，搭配胡萝卜和鸡蛋更添营养。制作难度中等，新手需掌握火候，但步骤明确易上手。从备料到完成大约需要 1 小时。",
  "ingredients": [
    "面粉（非自发粉）",
    "肉沫",
    "油",
    "盐",
    "糖",
    "生粉",
    "酱油",
    "风味调料（如鸡粉、孜然、椒盐，可选）",
    "蒜头",
    "大葱",
    "鸡蛋（可选）",
    "胡萝卜（可选）",
    "平底锅",
    "炒锅（可以使用同一个平底锅替代）"
  ],
  "steps": [
    {
      "title": "准备原料",
      "items": [
        {
          "sub": false,
          "text": "取肉沫（解冻），加入 1/2 所有上述调料（油、盐、糖、酱油、风味调料）和全部的生粉，搅拌均匀，腌制 30 分钟。"
        },
        {
          "sub": false,
          "text": "将面粉加入碗中，加入鸡蛋，加入剩下 1/2 所有上述调料，加入相当于面粉 1/2 的水（使得面粉相对粘稠但可以流动），搅拌均匀。"
        },
        {
          "sub": false,
          "text": "蒜头切为蒜末。"
        },
        {
          "sub": false,
          "text": "大葱切段。"
        },
        {
          "sub": false,
          "text": "胡萝卜切末（作为馅料用，所以要求尽量细碎，可用乱刀）"
        }
      ]
    },
    {
      "title": "烹饪",
      "items": [
        {
          "sub": false,
          "text": "热锅冷油，宽油起锅。"
        },
        {
          "sub": false,
          "text": "待油烧热后，放入蒜末爆香。"
        },
        {
          "sub": false,
          "text": "加入腌制的肉沫，翻炒，直至断生。"
        },
        {
          "sub": false,
          "text": "将胡萝卜末加入肉沫中一同翻炒，直至油被染为金黄色（这是为了萃取胡萝卜的风味）。"
        },
        {
          "sub": false,
          "text": "关火。冷却 2 分钟。"
        },
        {
          "sub": false,
          "text": "将炒好的肉沫倒入生面糊中，搅匀。"
        },
        {
          "sub": false,
          "text": "重新开火，平底锅铺底油。"
        },
        {
          "sub": false,
          "text": "调至小火，将面糊倒入锅中均匀铺满。保证厚度不要过高。可以端起锅，让面糊流过锅底来完成这一操作。"
        },
        {
          "sub": false,
          "text": "在饼的表面尚为液态时，撒上大葱段。"
        },
        {
          "sub": false,
          "text": "保持小火，直到底面凝固。"
        },
        {
          "sub": false,
          "text": "将饼翻面，继续小火煎烤，直至另一侧凝固。"
        },
        {
          "sub": false,
          "text": "之后，每一面再额外煎 20 秒。"
        },
        {
          "sub": false,
          "text": "关火出锅。"
        }
      ]
    }
  ],
  "tips": [
    "将肉沫和胡萝卜末加入面糊后，应该尽量搅匀，保证味道扩散到饼内各处。",
    "肉沫和胡萝卜末即馅料可以使用各类熟馅料替代。"
  ],
  "video": null,
