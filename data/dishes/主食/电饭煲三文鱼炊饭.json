    "金菇（可选）",
    "冬菇（可选）",
    "工具",
    "电饭煲"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "三文鱼去鳞，去骨"
        },
        {
          "sub": false,
          "text": "金菇、冬菇切碎"
        },
        {
          "sub": false,
          "text": "洗米三次"
        },
        {
          "sub": false,
          "text": "把三文鱼、米、牛油放入电饭煲"
        },
        {
          "sub": false,
          "text": "想口感浓厚一点，可以加多一汤匙牛油"
        },
        {
          "sub": false,
          "text": "根据电饭煲的刻度放水"
        },
        {
          "sub": false,
          "text": "把电饭煲調較至煲飯模式，等待大約 30 - 45 分鐘"
        }
      ]
    }
