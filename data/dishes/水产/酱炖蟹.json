  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "把螃蟹刷洗干净，然后在砧板上对半劈开"
        },
        {
          "sub": false,
          "text": "锅里下菜油，放入姜末和豆瓣酱爆香，加入冰糖炒化，直到冒小气泡就盛出"
        },
        {
          "sub": false,
          "text": "在盘子里铺上一层酱，然后把切好的螃蟹切开面朝下，整齐排放在酱上"
        },
        {
          "sub": false,
          "text": "放点葱段和姜片，建议敲个鸡蛋或在盘底铺肉末"
        },
        {
          "sub": false,
          "text": "上锅蒸 10-12 分钟"
        }
      ]
    }
  ],
