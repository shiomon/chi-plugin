      "items": [
        {
          "sub": false,
          "text": "用刀从虾头中间切开，切到距离虾尾 1 cm"
        },
        {
          "sub": false,
          "text": "将蒜蓉酱铺在虾身中间，放在盘子中"
        },
        {
          "sub": false,
          "text": "锅中倒入热水，将盘子放入锅中，大火蒸 3 分钟"
        },
        {
          "sub": false,
          "text": "烧热油，倒入虾盘中，倒入生抽"
        }
      ]
