    "金针菇 150 g （约 1 小包）",
    "小葱 5 g",
    "大蒜 2 瓣",
    "生抽 15 ml",
    "醋 10 ml",
    "白糖 3 g（可选）",
    "香油 5 ml（可选）",
    "辣椒油 5 ml（可选）"
  ],
