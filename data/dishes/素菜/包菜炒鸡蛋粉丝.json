{
  "id": "素菜/包菜炒鸡蛋粉丝",
  "md": "dishes/vegetable_dish/包菜炒鸡蛋粉丝/包菜炒鸡蛋粉丝.md",
  "name": "包菜炒鸡蛋粉丝",
  "category": "vegetable_dish",
  "categoryName": "素菜",
  "difficulty": 3,
  "calories": 570,
  "time": "1小时",
  "desc": "包菜炒鸡蛋粉丝是一道咸鲜可口的家常快手菜，脆甜的包菜丝与软韧的粉丝、嫩滑的鸡蛋相互融合，口感层次丰富。包菜富含维生素和膳食纤维，鸡蛋提供优质蛋白质，胡萝卜增添营养，荤素搭配均衡。制作时需要提前浸泡粉丝，整体流程稍多但操作并不复杂，对新手有一定挑战性。从备料到出锅，大约需要 1 小时 20 分钟。",
  "ingredients": [
    "包菜",
    "鸡蛋",
    "粉丝",
    "胡萝卜",
    "菜籽油",
    "盐、生抽、老抽、蚝油",
    "葱、蒜、干辣椒"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "胡萝卜、包菜切丝备用"
        },
        {
          "sub": false,
          "text": "粉丝先用冷水浸泡 1 小时，然后将粉丝放入锅中，加入开水烧至粉丝烫软捞出备用"
        },
        {
          "sub": false,
          "text": "鸡蛋打入碗中，加入盐后搅拌 15 秒"
        },
        {
          "sub": false,
          "text": "葱、蒜、辣椒切成小粒备用"
        },
        {
          "sub": false,
          "text": "起锅烧油，倒入鸡蛋，打散炒熟盛出"
        },
        {
          "sub": false,
          "text": "再倒入油，放入葱、蒜、干辣椒翻炒 8 秒"
        },
        {
          "sub": false,
          "text": "下胡萝卜、包菜丝儿翻炒 30 秒"
        },
        {
          "sub": false,
          "text": "放入粉丝"
        },
        {
          "sub": false,
          "text": "放调料，生抽 15 ml，老抽 10 ml，蚝油 10 ml，盐 2 克"
        },
        {
          "sub": false,
          "text": "放入之前炒好的鸡蛋，翻炒约 15 秒"
        },
        {
          "sub": false,
          "text": "出锅摆盘"
        }
      ]
    }
  ],
