    "豆腐 250 g （约 1 块常见大小的豆腐）",
    "小葱 10 g",
    "大蒜 2-3 瓣",
    "生抽 15 ml",
    "香油 5 ml",
    "醋 5 ml（可选）",
    "白糖 2 g（可选）",
    "辣椒油 5 ml（可选）"
  ],
