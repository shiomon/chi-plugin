  "desc": "皮蛋豆腐是一道清爽开胃的凉拌家常菜，松花蛋 Q 弹滑嫩，嫩豆腐入口即化，咸香微酸的口味特别下饭。豆腐富含优质植物蛋白和钙，皮蛋则提供铁、维生素 A 等营养素，搭配食用易于消化吸收。制作过程几乎零门槛，新手也能轻松完成，从备料到上桌仅需 大约 5 分钟。",
  "ingredients": [
    "皮蛋",
    "内酯豆腐",
    "生抽",
    "白砂糖",
    "醋（推荐镇江香醋）",
    "香油（可选）",
    "辣椒油（可选）",
    "花生碎（可选）",
    "葱花（可选）",
    "香菜（可选）"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "先把皮蛋剥壳，切成四瓣。"
        },
        {
          "sub": false,
          "text": "嫩豆腐切块或者切片放中间。"
        },
        {
          "sub": false,
          "text": "将生抽、白砂糖、醋、香油、辣椒油调成酱汁，淋上去。"
        },
        {
          "sub": false,
          "text": "最后可选撒上花生碎、葱花、香菜。"
        }
      ]
    }
  ],
