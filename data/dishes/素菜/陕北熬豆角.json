  "name": "陕北熬豆角",
  "category": "vegetable_dish",
  "categoryName": "素菜",
  "difficulty": 2,
  "calories": 191,
  "time": "30分钟",
  "desc": "这是一道西北农家风味的炖菜，豆角绵软、土豆沙糯、番茄汤汁浓郁，酸香开胃。富含膳食纤维、维生素和碳水化合物，营养均衡。做法极其简单，食材用量可随喜好调整，几乎没有失败的可能，对新手特别友好。从备料到出锅，大约只需 30 分钟。",
  "ingredients": [
    "豆角",
    "土豆",
    "西红柿",
    "螺丝椒（可选）",
    "盐",
    "生抽",
    "五香粉",
    "蚝油",
    "葱",
    "姜",
    "蒜"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "葱切花，蒜切沫，姜切丝，备用。"
        },
        {
          "sub": false,
          "text": "豆角去筋，切2-10cm小段，备用。"
        },
        {
          "sub": false,
          "text": "土豆去皮，切1cm³小块，备用。"
        },
        {
          "sub": false,
          "text": "西红柿去皮，切1cm³小块，备用。"
        },
        {
          "sub": false,
          "text": "辣椒去仔，切0.15cm 宽条，备用。"
        },
        {
          "sub": false,
          "text": "起锅烧油(10ml - 15ml)，冒烟后放入葱姜蒜，翻炒至闻到葱姜蒜香味；"
        },
        {
          "sub": false,
          "text": "加入豆角，翻炒至变色（青绿色变为翠绿色）；"
        },
        {
          "sub": false,
          "text": "加入土豆块，翻炒 30s；"
        },
        {
          "sub": false,
          "text": "加入热水（水面刚刚漫过菜），盖上锅盖熬至土豆变软（可以用筷子确认）；"
        },
        {
          "sub": false,
          "text": "加入西红柿块，加入盐，生抽，蚝油，五香粉，辣椒，熬至西红柿成汁（注意搅拌，防止糊锅）；"
        },
        {
          "sub": false,
          "text": "加入香菜碎，出锅。"
        }
      ]
    }
  ],
  "tips": [
    "加入西红柿后开始继续熬制后，需要偶尔翻搅防止糊底"
  ],
