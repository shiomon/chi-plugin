  "desc": "山药南瓜炖鸡汤是一道秋冬暖身汤品，山药健脾、南瓜香甜、板栗粉糯，一锅炖出鲜甜。富含蛋白质、膳食纤维与多种维生素，营养均衡。做法简单，从备料到出锅大约需要 50 分钟，新手也能轻松完成。",
  "ingredients": [
    "鸡肉",
    "姜",
    "料酒（焯水用）",
    "板栗",
    "山药",
    "小南瓜",
    "红枣",
    "盐（出锅调味）"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "鸡肉切块，加姜、料酒，冷水下锅焯水，水开后煮 3 分钟捞出备用"
        },
        {
          "sub": false,
          "text": "山药去皮切滚刀块，板栗去壳备用"
        },
        {
          "sub": false,
          "text": "小南瓜洗净，上锅蒸熟后挖出果肉，压成南瓜泥备用"
        },
        {
          "sub": false,
          "text": "将焯好的鸡肉、山药、板栗、姜片放入锅中，加水没过食材，大火烧开后转小火炖 30 分钟"
        },
        {
          "sub": false,
          "text": "加入南瓜泥搅开，放入红枣，再煮 10 分钟"
        },
        {
          "sub": false,
          "text": "加盐调味，盛出即可"
        }
      ]
    }
  ],
  "tips": [
    "南瓜泥最后放，汤色金黄不浑浊",
    "山药去皮时建议戴手套，可避免手部发痒"
  ],
