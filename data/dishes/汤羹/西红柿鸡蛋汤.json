  "desc": "西红柿鸡蛋汤是一道酸甜开胃、口感滑嫩的家常汤品，做法极简，属于老少皆宜的大众菜肴。富含番茄红素、维生素 C 和优质蛋白质，营养均衡易吸收。对新手非常友好，快手省时，预计制作时长 大约 15 分钟。",
  "ingredients": [
    "西红柿",
    "鸡蛋",
    "香油",
    "味素",
    "盐",
    "葱、姜、蒜"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "将西红柿洗净，切块。"
        },
        {
          "sub": false,
          "text": "葱姜蒜切碎。"
        },
        {
          "sub": false,
          "text": "鸡蛋打到碗中，用筷子（或打蛋器）搅拌均匀。"
        },
        {
          "sub": false,
          "text": "热锅，并放入 15 毫升的油，待能从油中看到冒出一丝烟时，放入葱姜蒜翻炒 30 秒。"
        },
        {
          "sub": false,
          "text": "放入西红柿翻炒 1 分钟。"
        },
        {
          "sub": false,
          "text": "倒入水，水的高度大约为锅内菜品高度的 1.2 倍，并放入盐。"
        },
        {
          "sub": false,
          "text": "待开锅后，将鸡蛋液放入，并用筷子将鸡蛋打散，放入味素和香油。"
        },
        {
          "sub": false,
          "text": "等待 30 秒，关火出锅。"
        }
      ]
    }
  ],
  "tips": [
    "味素可加可不加。"
  ],
