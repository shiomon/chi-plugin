  "name": "油泼辣子",
  "category": "condiment",
  "categoryName": "调料",
  "difficulty": 3,
  "calories": 1854,
  "time": "10分钟",
  "desc": "一道香辣扑鼻的陕西风味调味料，红油润泽，芝麻蒜香交织，入口辣而不燥、回味绵长。辣椒富含维生素 C 与辣椒素，能增进食欲、暖身驱寒。制作过程需掌握油温，对新手稍有挑战，但按部就班即可成功。全程约 10 分钟完成，是家常拌菜拌面的点睛之笔。",
  "ingredients": [
    "蒜头",
    "干辣椒面",
    "盐",
    "熟白芝麻",
    "小米椒",
    "花生油（可用菜籽油替换）",
    "家庭小陶瓷碗",
    "家庭铁勺子",
    "五香粉 （可选）",
    "草寇（可选）",
    "小葱 （可选）",
    "八角",
    "花椒",
    "香叶",
    "白芷",
    "姜片（可选）",
    "糖",
    "白醋"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "拿出蒜头掰 2 个小蒜头去皮"
        },
        {
          "sub": false,
          "text": "拿出砧板剁碎小蒜头、小米椒"
        },
        {
          "sub": false,
          "text": "拿出碗倒入花生油"
        },
        {
          "sub": false,
          "text": "油热放入其他配料和小葱,等到香料变焦，捞出扔掉"
        },
        {
          "sub": false,
          "text": "拿出铁锅将碗内的油放入加热 2 分钟（菜籽油烧至冒烟）"
        },
        {
          "sub": false,
          "text": "此时是空碗"
        },
        {
          "sub": false,
          "text": "往空碗加入干辣椒面、白芝麻、蒜末、小米椒、盐、五香粉、草寇作为\"调料\""
        },
        {
          "sub": false,
          "text": "关火将油温冷却至 210 摄氏度"
        },
        {
          "sub": false,
          "text": "将锅内热油倒入碗内并用勺子搅拌即可（可以在 165 摄氏度时加入同样\"调料\"的碗最后进行混合进行增辣）"
        },
        {
          "sub": false,
          "text": "倒入热油稍微搅拌后放入白醋，此时会重新沸腾。继续进行搅拌，白醋增香。"
        },
        {
          "sub": false,
          "text": "油泼辣子冷却到温热放白糖和味精，白糖可以使辣味柔和，不会那么地呛口"
        }
      ]
    }
  ],
  "tips": [
    "五香粉、草寇作为\"调料\"加入，可以增加香味，使油泼辣子更香"
  ],
  "video": null,
  "image": "dishes/condiment/油泼辣子/油泼辣子.jpg",
  "calc": [
    "蒜头 1 个",
    "干辣椒面 100 克",
    "盐 5 克",
    "熟白芝麻 15 克",
    "小米椒 1 个",
    "花生油 150 毫升 （可用菜籽油替换）",
    "五香粉 10 克（可选）",
    "草寇 1 个（可选）",
    "小葱 3-5 根（可选）",
    "其他配料：八角(1)、花椒（20-50 粒都可，看个人口味）、香叶（2-3 片）、白芷（2-3 片）、姜片（大拇指粗细的姜切片）（可选）",
    "糖 30 克",
    "白醋 5 ml（大概就是小铁勺子的量）"
  ]
}
