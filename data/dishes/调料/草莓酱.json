  "category": "condiment",
  "categoryName": "调料",
  "difficulty": 2,
  "calories": 1940,
  "time": null,
  "desc": "这是一道酸甜可口、果香浓郁的家常果酱，非常适合涂抹面包。草莓富含维生素 C，不过熬煮时糖分较高，可依口味调整。做法非常简单，新手也能轻松搞定，从准备到熬好大约需要两个小时。",
  "ingredients": [
    "草莓",
    "白砂糖",
    "保鲜膜"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "草莓洗净去叶"
        },
        {
          "sub": false,
          "text": "将草莓切碎放入合适的碗中"
        },
        {
          "sub": false,
          "text": "将白糖倒入碗中与草莓搅拌均匀"
        },
        {
          "sub": false,
          "text": "碗用保鲜膜覆盖静置 1 小时"
        },
        {
          "sub": false,
          "text": "将静置的草莓和糖的混合物倒入不粘锅中开大火烧开"
        },
        {
          "sub": false,
          "text": "烧开后转小火不断搅拌直至果酱呈粘稠状关火"
        },
        {
          "sub": false,
          "text": "待草莓酱冷却后装入准备好的密封罐中"
        }
      ]
    }
  ],
