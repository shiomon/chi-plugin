{
  "id": "饮品/金菲士",
  "md": "dishes/drink/金菲士/金菲士.md",
  "name": "金菲士",
  "category": "drink",
  "categoryName": "饮品",
  "difficulty": 2,
  "calories": 150,
  "time": "5分钟",
  "desc": "经典金酒鸡尾酒，酸甜适口，气泡激爽。柠檬提供丰富维 C，搭配蔗糖糖浆平衡酸度。制作非常简单，新手只需 5 分钟即可调制完成，适合在家轻松享用。注意饮酒有害健康，请勿过量。",
  "ingredients": [
    "原料",
    "金酒",
    "苏打气泡水",
    "柠檬",
    "[蔗糖糖浆](../../condiment/蔗糖糖浆/蔗糖糖浆.md)",
    "冰块",
    "新鲜绿叶（可选，装饰用）",
    "工具",
    "手动压汁器",
    "雪克瓶（可选）"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "将柠檬对半切（刀方向垂直于柠檬的头尾连线），并从其中的一半中切取一片柠檬备用"
        },
        {
          "sub": false,
          "text": "再次将柠檬对半切，将得到的 4 角柠檬用压汁器压出柠檬汁置于容器中备用"
        },
        {
          "sub": false,
          "text": "选择一个杯子，建议使用容量在 350~400 毫升的透明玻璃杯"
        },
        {
          "sub": false,
          "text": "将 100 克冰块放置在杯底"
        },
        {
          "sub": false,
          "text": "倒入 30~40 毫升金酒"
        },
        {
          "sub": false,
          "text": "倒入 20 毫升柠檬汁（如果喜酸可以加多点或全加）"
        },
        {
          "sub": false,
          "text": "倒入 30~40 克蔗糖糖浆"
        },
        {
          "sub": false,
          "text": "用勺子搅拌均匀"
        },
        {
          "sub": false,
          "text": "将之前准备的一片柠檬放置好"
        },
        {
          "sub": false,
          "text": "缓慢沿杯壁注入苏打气泡水直至满杯（不要倒在冰上，避免起泡流失）"
        },
        {
          "sub": false,
          "text": "用勺子轻轻上下提拉将液体搅拌均匀（不要旋转搅拌，避免起泡流失）"
        },
        {
          "sub": false,
          "text": "在液面放置好装饰用的绿叶（可选）"
        },
        {
          "sub": false,
          "text": "将冰块、金酒、柠檬汁、蔗糖糖浆倒入雪克瓶，雪克均匀"
        },
        {
          "sub": false,
          "text": "将充分雪克的产物倒到杯子中（如果里面的冰太碎了，可以选择过滤其中的冰，重新往杯中补充冰块）"
        }
      ]
    }
  ],
  "tips": [
    "成品"
  ],
