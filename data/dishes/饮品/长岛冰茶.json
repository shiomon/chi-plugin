  "desc": "长岛冰茶是一款口感酷似冰茶、入口柔和但酒精度颇高的经典鸡尾酒。它本身营养价值不高，偶尔小酌可放松身心，但切勿过量。做法非常简单，只需按比例混合四种基酒、甜酒和果汁，新手也能轻松调制。从准备到完成仅需 大约 5 分钟。",
  "ingredients": [
    "金酒",
    "龙舌兰酒",
    "伏特加",
    "白朗姆酒",
    "橙味甜酒",
    "柠檬",
    "枫糖浆",
    "可乐",
    "冰块",
    "高球杯（容量 300ml）"
  ],
  "steps": [
    {
      "title": null,
      "items": [
        {
          "sub": false,
          "text": "柠檬对半切，挤出 30ml 柠檬汁至杯中；"
        },
        {
          "sub": false,
          "text": "依次向杯中加入："
        },
        {
          "sub": true,
          "text": "15ml 金酒，"
        },
        {
          "sub": true,
          "text": "15ml 龙舌兰酒，"
        },
        {
          "sub": true,
          "text": "15ml 伏特加，"
        },
        {
          "sub": true,
          "text": "15ml 白朗姆酒，"
        },
        {
          "sub": true,
          "text": "15ml 橙味甜酒；"
        },
        {
          "sub": false,
          "text": "向杯中缓慢倒入 20ml 枫糖浆，边倒边搅拌；"
        },
        {
          "sub": false,
          "text": "向杯中加入 75ml 可乐；"
        },
        {
          "sub": false,
          "text": "向杯中加入冰块直至满杯；"
        },
        {
          "sub": false,
          "text": "轻轻搅拌 20 秒；"
        },
        {
          "sub": false,
          "text": "开始享用."
        }
      ]
    }
  ],
